public static String removeDuplicates(String str){
        String s="";
        for(int i=0;i<str.length();i++){
            boolean flag=false;
            char ch=str.charAt(i);
            for(int j=0;j<s.length();j++){
                if(ch==s.charAt(j)){
                    flag=true;
                    break;
                }
            }
            if(!flag){
                s=s+ch;
            }
        }
        return s;
}
